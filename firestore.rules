rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function maintenanceEnabled() {
      return exists(/databases/$(database)/documents/systemConfig/global)
             && get(/databases/$(database)/documents/systemConfig/global).data.maintenance.enabled == true;
    }

    function userDisabled(userId) {
      return exists(/databases/$(database)/documents/adminUserStatus/$(userId))
             && get(/databases/$(database)/documents/adminUserStatus/$(userId)).data.disabled == true;
    }

    match /userData/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId
                  && !userDisabled(userId);

      // request.resource is null on delete, so document-shape checks only apply
      // to writes that create or update a document.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && !userDisabled(userId)
                            && !maintenanceEnabled()
                            && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
                            && request.resource.data.data is map
                            && request.resource.data.updatedAt is string;

      // Account deletion must be able to remove its own userData document.
      // Maintenance mode and a disabled account still block this write.
      allow delete: if request.auth != null
                    && request.auth.uid == userId
                    && !userDisabled(userId)
                    && !maintenanceEnabled();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
